# Copie este arquivo para ".env" e preencha com seus dados.
# O arquivo .env está no .gitignore e NÃO vai para o GitHub.

# Connection string do MongoDB Atlas (Atlas > Connect > Drivers).
# Caracteres especiais na senha precisam de URL-encoding (ex.: @ vira %40).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=login_seguro

# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=TroqueEstaSenha123

# Aparência
APP_NOME=Login Seguro
APP_TEMA=padrao

# Use true quando o sistema estiver em HTTPS (produção)
COOKIE_SECURE=false

# ---------- Recuperação de senha por e-mail ----------
# Gmail: use uma "senha de app" (myaccount.google.com/apppasswords), sem espaços.
# Se MAIL_HOST ficar vazio, o link de recuperação aparece no terminal (modo de teste).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senhadeappcom16letras
APP_URL=http://localhost:8080
